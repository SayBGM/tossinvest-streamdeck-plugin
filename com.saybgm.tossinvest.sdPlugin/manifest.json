{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Author": "SayBGM",
  "Name": "TossInvest",
  "Description": "토스증권 Open API로 국내·미국 주식 현재가를 표시하는 비공식 플러그인",
  "Version": "0.1.0.0",
  "Icon": "imgs/plugin-icon",
  "UUID": "com.saybgm.tossinvest",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
  "Category": "TossInvest",
  "CategoryIcon": "imgs/category-icon",
  "CodePath": "bin/plugin.js",
  "Actions": [
    {
      "UUID": "com.saybgm.tossinvest.quote",
      "Name": "주식 시세",
      "Icon": "imgs/quote-action",
      "Tooltip": "국내·미국 주식 현재가",
      "PropertyInspectorPath": "ui/quote.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/quote-action"
        }
      ]
    }
  ]
}