{
  "name": "tossinvest-streamdeck-plugin",
  "version": "0.1.0",
  "description": "Unofficial Toss Securities quote plugin for Stream Deck",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c && node scripts/verify-build.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs",
    "package:smoke": "node scripts/verify-package.mjs && node scripts/runtime-smoke.mjs && node scripts/verify-plugin-runtime.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@elgato/cli": "1.9.0",
    "@rollup/plugin-commonjs": "28.0.9",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "adm-zip": "^0.6.0",
    "rollup": "^4.63.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
